{
  "variable": "appST",
  "colors": {
    "primary": { "light": "#6750A4", "dark": "#D0BCFF" },
    "surface": { "light": "#FFFFFF", "dark": "#1E1E1E" },
    "background": { "light": "#F7F7F7", "dark": "#121212" },
    "text": { "light": "#1C1B1F", "dark": "#E6E1E5" },
    "extra": {
      "brand": { "light": "#FFB800" }
    }
  },
  "radius": { "sm": 8, "md": 12, "lg": 16 },
  "typography": {
    "label": { "fontSize": 14, "fontWeight": 600 },
    "sublabel": { "fontSize": 12, "colorName": "textSecondary" },
    "description": { "fontSize": 14, "height": 1.4, "colorName": "textSecondary" }
  },
  "components": {
    "card": { "elevation": 0 },
    "button": { "elevation": 0 }
  },
  "extras": {
    "ghost": {
      "kind": "button",
      "foreground": { "light": "#6750A4", "dark": "#D0BCFF" },
      "elevation": 0
    },
    "destructive": {
      "kind": "button",
      "fill": { "light": "#B3261E", "dark": "#F2B8B5" },
      "elevation": 0
    },
    "product": { "kind": "card", "elevation": 0, "radius": 20 },
    "highlighted": {
      "kind": "container",
      "fill": { "light": "#FFF8E1", "dark": "#3E2723" }
    },
    "price": { "kind": "text", "fontSize": 18, "fontWeight": 600, "colorName": "primary" }
  }
}
